            "description": "Read-only facility-service details. Both HIP and HIU flags were confirmed by a separate backend readback on 24 Sep. Postman results must be independently observed."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.variables.replaceIn(pm.request.url.toString()) !== \"https://dev.abdm.gov.in/api/hiecm/gateway/v3/bridge-service/serviceId/IN0910034387\") {",
                  "  pm.execution.skipRequest(); throw new Error(\"Unexpected destination; request skipped.\");",
                  "}",
                  "pm.variables.set(\"request_id\", pm.variables.replaceIn(\"{{$guid}}\"));",
                  "pm.variables.set(\"request_timestamp\", new Date().toISOString());",
                  "try {\n const token = await pm.vault.get(\"healthdoc-abdm-access-token\");\n if (typeof token !== \"string\" || !token.trim()) {\n  pm.execution.skipRequest(); throw new Error(\"Missing session token.\");\n }\n} catch (error) {\n pm.execution.skipRequest(); throw new Error(\"Local Vault session token unavailable. Run the separately approved session request first.\");\n}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Service details HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  " const data = pm.response.json();",
                  " pm.test(\"Correct service belongs to this bridge\", () => {",
                  "  pm.expect(data.bridgeId).to.equal(\"SBXID_053401\");",
                  "  pm.expect(data.serviceId).to.equal(\"IN0910034387\");",
                  " });",
                  " pm.test(\"HIP, HIU and active flags are true\", () => {",
                  "  pm.expect(data.isHip).to.equal(true);",
                  "  pm.expect(data.isHiu).to.equal(true);",
                  "  pm.expect(data.active).to.equal(true);",
                  " });",
                  "}"
                ]
              }
            }
          ],
          "response": []
        }
      ]
