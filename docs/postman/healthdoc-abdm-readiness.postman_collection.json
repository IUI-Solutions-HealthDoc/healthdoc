{
  "info": {
    "name": "HealthDoc ABDM — Readiness and Webhook Evidence (24 Sep)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Credential-free sandbox readiness requests. Correct facility/HIP/HIU service: IN0910034387; bridge SBXID_053401. No registry writes, OTPs, patient identifiers, clinical bodies or captured responses. GET 405 proves routing only. Session is separately armed and uses Local Vault. Do not run all requests as milestone acceptance. See README.md and the self-service runbook."
  },
  "variable": [
    {
      "key": "arm_session_once",
      "value": "no",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "00 Public callback routing — synthetic, not milestone passes",
      "item": [
        {
          "name": "M1 profile share — GET probe, expect 405",
          "protocolProfileBehavior": {
            "followRedirects": false
          },
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "url": "https://abdm.healthdoc.world/api/v3/hip/patient/share",
            "description": "Synthetic routing check only. This does NOT execute the milestone or prove NHA origin. Actual callbacks use POST. Do not change method/body to replay a real callback."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.variables.replaceIn(pm.request.url.toString()) !== \"https://abdm.healthdoc.world/api/v3/hip/patient/share\") {",
                  "  pm.execution.skipRequest(); throw new Error(\"Unexpected destination; request skipped.\");",
                  "}",
                  "pm.variables.set(\"request_id\", pm.variables.replaceIn(\"{{$guid}}\"));",
                  "pm.variables.set(\"request_timestamp\", new Date().toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"POST-only route reached: HTTP 405\", () => pm.response.to.have.status(405));",
                  "pm.test(\"Durable HealthDoc receipt ID present\", function () {",
                  "  pm.expect(pm.response.headers.get(\"X-HealthDoc-Receipt-ID\")).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
