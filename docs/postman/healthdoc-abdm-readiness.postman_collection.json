    {
      "name": "02 NHA registration — Local Vault and manual session",
      "item": [
        {
          "name": "01 Session — manual arm and Local Vault required",
          "protocolProfileBehavior": {
            "followRedirects": false
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "REQUEST-ID",
                "value": "{{request_id}}",
                "type": "text"
              },
              {
                "key": "TIMESTAMP",
                "value": "{{request_timestamp}}",
                "type": "text"
              },
              {
                "key": "X-CM-ID",
                "value": "sbx",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "https://dev.abdm.gov.in/api/hiecm/gateway/v3/sessions",
            "description": "Creates a short-lived NHA sandbox gateway session. User must add healthdoc-abdm-client-secret to LOCAL Vault, approve this collection's vault scripts, and set arm_session_once to yes immediately before Send. No patient data. Never save the response as an example; it contains tokens.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientId\": \"SBXID_053401\",\n  \"clientSecret\": \"{{vault:healthdoc-abdm-client-secret}}\",\n  \"grantType\": \"client_credentials\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.variables.replaceIn(pm.request.url.toString()) !== \"https://dev.abdm.gov.in/api/hiecm/gateway/v3/sessions\") {",
                  "  pm.execution.skipRequest(); throw new Error(\"Unexpected destination; request skipped.\");",
                  "}",
                  "pm.variables.set(\"request_id\", pm.variables.replaceIn(\"{{$guid}}\"));",
                  "pm.variables.set(\"request_timestamp\", new Date().toISOString());",
                  "if (pm.collectionVariables.get(\"arm_session_once\") !== \"yes\") {",
                  " pm.execution.skipRequest(); throw new Error(\"Session is not armed. Review Local Vault setup, then set arm_session_once=yes for one send.\");",
                  "}",
                  "pm.collectionVariables.set(\"arm_session_once\", \"no\");",
                  "try {",
                  " const secret = await pm.vault.get(\"healthdoc-abdm-client-secret\");",
                  " if (typeof secret !== \"string\" || !secret.trim()) {",
                  "  pm.execution.skipRequest(); throw new Error(\"Client secret missing from Local Vault.\");",
                  " }",
                  "} catch (error) {",
                  " pm.execution.skipRequest(); throw new Error(\"Local Vault unavailable or secret missing. Nothing should be sent; complete Vault setup.\");",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Session HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  " const data = pm.response.json();",
                  " const token = data.accessToken || data.access_token;",
                  " const ttl = Number(data.expiresIn || data.expires_in);",
                  " pm.test(\"Session contains a token and positive expiry\", () => {",
                  "   pm.expect(token).to.be.a(\"string\").and.not.empty;",
                  "   pm.expect(Number.isFinite(ttl) && ttl > 0).to.equal(true);",
                  " });",
                  " if (typeof token === \"string\" && token && Number.isFinite(ttl) && ttl > 0) {",
                  "   await pm.vault.set(\"healthdoc-abdm-access-token\", token);",
                  " }",
                  "}",
                  "// No token/body logging, environment persistence, or automatic next request."
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "02 Read bridge and services — expect 200",
          "protocolProfileBehavior": {
            "followRedirects": false
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "REQUEST-ID",
                "value": "{{request_id}}",
                "type": "text"
              },
              {
                "key": "TIMESTAMP",
                "value": "{{request_timestamp}}",
                "type": "text"
              },
              {
                "key": "X-CM-ID",
                "value": "sbx",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{vault:healthdoc-abdm-access-token}}",
                  "type": "string"
                }
              ]
            },
            "url": "https://dev.abdm.gov.in/api/hiecm/gateway/v3/bridge-services",
            "description": "Read-only registration inventory. Does not register or edit a service. Token stays in Local Vault."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.variables.replaceIn(pm.request.url.toString()) !== \"https://dev.abdm.gov.in/api/hiecm/gateway/v3/bridge-services\") {",
                  "  pm.execution.skipRequest(); throw new Error(\"Unexpected destination; request skipped.\");",
                  "}",
                  "pm.variables.set(\"request_id\", pm.variables.replaceIn(\"{{$guid}}\"));",
                  "pm.variables.set(\"request_timestamp\", new Date().toISOString());",
                  "try {\n const token = await pm.vault.get(\"healthdoc-abdm-access-token\");\n if (typeof token !== \"string\" || !token.trim()) {\n  pm.execution.skipRequest(); throw new Error(\"Missing session token.\");\n }\n} catch (error) {\n pm.execution.skipRequest(); throw new Error(\"Local Vault session token unavailable. Run the separately approved session request first.\");\n}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Bridge inventory HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  " const data = pm.response.json();",
                  " pm.test(\"Correct bridge and callback URL\", () => {",
                  "  pm.expect(data.bridge.id).to.equal(\"SBXID_053401\");",
                  "  pm.expect(data.bridge.url).to.equal(\"https://abdm.healthdoc.world\");",
                  "  pm.expect(data.bridge.active).to.equal(true);",
                  " });",
                  " pm.test(\"Correct new facility is active\", () => {",
                  "  pm.expect(data.services.some(s => s.id === \"IN0910034387\" && s.active === true)).to.equal(true);",
                  " });",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
