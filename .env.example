# Copy to .env — never commit real secrets
POSTGRES_USER=healthdoc
POSTGRES_PASSWORD=change-me
POSTGRES_DB=healthdoc
DATABASE_URL=postgresql+asyncpg://healthdoc:change-me@postgres:5432/healthdoc
MONGO_URI=mongodb://mongo:27017/healthdoc
REDIS_URL=redis://redis:6379/0

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
# Must exactly match the token's public `iss` claim.
JWT_ISSUER=https://localhost/auth/realms/healthdoc
# Backend-only transport address for fetching keys inside Compose. Production
# may point this at the same public issuer when internal DNS/TLS supports it.
JWT_JWKS_URL=http://keycloak:8080/auth/realms/healthdoc/protocol/openid-connect/certs
KEYCLOAK_PUBLIC_URL=https://localhost/auth
KEYCLOAK_BASE_URL=http://keycloak:8080/auth
KEYCLOAK_REALM=healthdoc
OIDC_CLIENT_ID=healthdoc-frontend
NEXT_PUBLIC_KEYCLOAK_URL=https://localhost/auth
NEXT_PUBLIC_KEYCLOAK_REALM=healthdoc
NEXT_PUBLIC_OIDC_CLIENT_ID=healthdoc-frontend

MINIO_ROOT_USER=healthdoc
MINIO_ROOT_PASSWORD=change-me-8chars-min
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET_FILES=hd-files
MINIO_BUCKET_REPORTS=hd-reports

ORTHANC_USER=healthdoc
ORTHANC_PASSWORD=change-me

# ABDM Gateway V3 application APIs. NHA may separately direct sandbox-only
# bridge provisioning through /gateway/v1/bridges during onboarding.
ABDM_GATEWAY_BASE_URL=https://dev.abdm.gov.in
ABDM_CLIENT_ID=change-me
ABDM_CLIENT_SECRET=change-me
ABDM_HFR_FACILITY_ID=change-me

# ABHA enrolment/login live on a DIFFERENT host from the HIECM gateway.
ABDM_ABHA_BASE_URL=https://abhasbx.abdm.gov.in/abha/api

# ABDM's PUBLIC certificate. Public key material, not a secret — but it rotates,
# so it is configuration. Aadhaar numbers, mobile numbers and OTPs are
# RSA-encrypted with it before transmission; without it the enrolment endpoints
# answer 503 rather than sending anything in the clear.
# Accepts a PUBLIC KEY or a CERTIFICATE block; \n escapes are normalised.
ABDM_PUBLIC_KEY_PEM=change-me
# X-CM-ID on every gateway call. 'sbx' for sandbox, 'abdm' for production.
ABDM_X_CM_ID=sbx

ENVIRONMENT=dev
NEXT_PUBLIC_API_BASE_URL=https://localhost/api/v1

# --- Host port overrides (only change if a port is busy on YOUR machine) ---
# Internal container ports never change; these only affect localhost access.
#POSTGRES_PORT=55432
#MONGO_PORT=27017
#REDIS_PORT=6379
#KEYCLOAK_PORT=8081
#MINIO_PORT=9000
#MINIO_CONSOLE_PORT=9001
#ORTHANC_PORT=8042
#ORTHANC_DICOM_PORT=4242
#BACKEND_PORT=8000
#FRONTEND_PORT=3000
#HTTP_PORT=80
#HTTPS_PORT=443

# ICD-11 (WHO ICD-API self-hosted container; see infra/docker-compose.yml)
ICD11_BASE_URL=http://icd11:80
#ICD11_PORT=8083

# Crypto keys — REQUIRED. App refuses to start with placeholders.
# Generate: python3 -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
PII_ENCRYPTION_KEY=
AADHAAR_HMAC_KEY=

# CORS — comma-separated extra origins for dev. Default: only Electron + https://localhost
CORS_ORIGINS=http://localhost:3000
