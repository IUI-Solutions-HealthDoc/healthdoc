{
  "realm": "healthdoc",
  "displayName": "HealthDoc HMIS",
  "displayNameHtml": "HealthDoc HMIS",
  "loginTheme": "healthdoc",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "waitIncrementSeconds": 900,
  "maxFailureWaitSeconds": 900,
  "permanentLockout": false,
  "minimumQuickLoginWaitSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "roles": {
    "realm": [
      {
        "name": "superadmin",
        "description": "Cloud-only platform owner: facilities, facility admins, DPO appointments, cross-facility MIS. NEVER patient/clinical data \u2014 including no merge/unmerge."
      },
      {
        "name": "receptionist",
        "description": "Registration, one-time payment, queue"
      },
      {
        "name": "doctor",
        "description": "Consultation, orders, prescriptions"
      },
      {
        "name": "nurse",
        "description": "Ward dashboard, eMAR, vitals"
      },
      {
        "name": "lab_tech",
        "description": "Pathology worklist and results"
      },
      {
        "name": "radiology_tech",
        "description": "Radiology worklist and PACS"
      },
      {
        "name": "pharmacist",
        "description": "Prescription queue, dispense, inventory"
      },
      {
        "name": "emergency",
        "description": "Emergency / THID fast registration"
      },
      {
        "name": "hod",
        "description": "Head of Department: runs ONE department (roster, queue oversight/reassignment, indent approval, dept dashboard). Scoped by users.department_id. MFA required."
      },
      {
        "name": "supervisor",
        "description": "Records authority: THID\u2192UHID merge approval, unmerge, identity overrides. MFA required. Deliberately NOT a department manager."
      },
      {
        "name": "admin",
        "description": "Facility configuration: users + account approvals, departments/rooms, assigns HODs, module toggles, billing config, facility MIS. Not a clinical or records authority."
      },
      {
        "name": "auditor",
        "description": "Read-only audit viewer"
      },
      {
        "name": "patient",
        "description": "Patient portal"
      }
    ]
  },
  "clients": [
    {
      "clientId": "healthdoc-frontend",
      "name": "HealthDoc Frontend (Next.js/Electron)",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": [
        "https://localhost/*",
        "http://localhost:3000/*",
        "https://192.168.7.106/*"
      ],
      "webOrigins": [
        "https://localhost",
        "http://localhost:3000",
        "https://192.168.7.106"
      ],
      "protocolMappers": [
        {
          "name": "Authentication Method Reference",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-amr-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "lightweight.claim": "false"
          }
        },
        {
          "name": "healthdoc-backend-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "healthdoc-backend",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      }
    },
    {
      "clientId": "healthdoc-backend",
      "name": "HealthDoc Backend (FastAPI)",
      "bearerOnly": true,
      "publicClient": false,
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "username": "dev.receptionist",
      "enabled": true,
      "firstName": "Dev",
      "lastName": "Receptionist",
      "email": "dev.receptionist@healthdoc.local",
      "credentials": [
        {
          "type": "password",
          "value": "devpass",
          "temporary": false
        }
      ],
