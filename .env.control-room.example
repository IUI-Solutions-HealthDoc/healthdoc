# The control-room server (infra/docker-compose.control-room.yml), on its own
# machine. Copy to .env.control-room; never commit the real file.
#
# Before the first start, on the hospital server's database as its owner:
#   psql "$OWNER_URL" -v ON_ERROR_STOP=1 -f infra/control-room/db-role.sql
#   psql "$OWNER_URL" -c "ALTER ROLE healthdoc_control_room LOGIN PASSWORD '<random>'"

# The address officers open. Must equal CONTROL_ROOM_HOST on the hospital
# server: the control realm's issuer is rendered from it.
CONTROL_ROOM_HOST=control.healthdoc.example.org
CONTROL_ROOM_TLS_CERT_PATH=/etc/healthdoc/tls/control-fullchain.pem
CONTROL_ROOM_TLS_KEY_PATH=/etc/healthdoc/tls/control-privkey.pem

# The hospital server over the private network (its PRIVATE_BIND_ADDRESS),
# as the restricted role. It cannot read patients or change clinical data.
CONTROL_ROOM_DATABASE_URL=postgresql+asyncpg://healthdoc_control_room:replace-with-random-password@10.0.0.5:5432/healthdoc
# The central Keycloak, reached privately. Only the healthdoc-control realm is
# proxied from here; the staff realm and the admin console are not.
KEYCLOAK_UPSTREAM=http://10.0.0.5:8080

HEALTHDOC_BACKEND_IMAGE=healthdoc/backend:replace-with-release-tag
HEALTHDOC_CONTROL_ROOM_FRONTEND_IMAGE=healthdoc/control-room-frontend:replace-with-release-tag

# The same PII key as the hospital server: the masked patient day codes on the
# activity trail are derived from it, and the settings loader requires it.
PII_ENCRYPTION_KEY=replace-with-the-hospital-servers-key
AADHAAR_HMAC_KEY=replace-with-the-hospital-servers-key
