# Copy outside the repository as .env.production, replace every placeholder,
# chmod 600, and back it up separately from application data.
# Keep credentials embedded in connection URLs URL-safe (letters, digits, _ and -).
PUBLIC_HOST=healthdoc.example.org
TLS_CERT_PATH=/etc/healthdoc/tls/fullchain.pem
TLS_KEY_PATH=/etc/healthdoc/tls/privkey.pem
POSTGRES_USER=healthdoc
POSTGRES_PASSWORD=replace-with-random-password
POSTGRES_DB=healthdoc
MONGO_ROOT_USER=healthdoc
MONGO_ROOT_PASSWORD=replace-with-random-password
REDIS_PASSWORD=replace-with-random-password
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=replace-with-random-password
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-random-password
MINIO_ROOT_USER=healthdoc
MINIO_ROOT_PASSWORD=replace-with-random-password
PII_ENCRYPTION_KEY=replace-with-base64-32-byte-key
AADHAAR_HMAC_KEY=replace-with-base64-32-byte-key
# ABDM. THE TWO VALUES BELOW WERE SANDBOX ONES IN A FILE NAMED
# .env.production.example, which is how a live deployment ends up talking to
# dev.abdm.gov.in with X-CM-ID: sbx and nobody noticing until certification.
# Replace both for a real deployment; they are left with the sandbox value
# commented beside them so the difference is visible rather than assumed.
ABDM_GATEWAY_BASE_URL=replace-for-environment   # sandbox is https://dev.abdm.gov.in
ABDM_ABHA_BASE_URL=replace-for-environment      # sandbox is https://abhasbx.abdm.gov.in/abha/api
ABDM_X_CM_ID=abdm                               # 'sbx' for sandbox, 'abdm' for production
ABDM_CLIENT_ID=replace-for-environment
ABDM_CLIENT_SECRET=replace-for-environment
ABDM_HFR_FACILITY_ID=replace-for-environment
# ABDM's public certificate. Rotates, so it is configuration. Without it the
# enrolment endpoints refuse rather than sending an Aadhaar number in the clear.
ABDM_PUBLIC_KEY_PEM=replace-for-environment
# Inbound HIP/HIU callbacks are REFUSED (503) while this is unset. That is the
# correct default — see integrations/abdm/callback_auth.py — but it does mean
# the gateway cannot reach this deployment until it is set.
ABDM_CALLBACK_SHARED_SECRET=replace-with-random-secret

# The app refuses to serve production traffic without this (see
# app/main.py::_assert_production_auth_hardening). Set it after a Keycloak
# re-import picks up the audience mapper.
JWT_AUDIENCE=healthdoc-backend
HEALTHDOC_BACKEND_IMAGE=healthdoc-backend:release
HEALTHDOC_FRONTEND_IMAGE=healthdoc-frontend:release
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-random-password
GRAFANA_PORT=3001

# ---------------------------------------------------------------------------
# FRONTEND — READ THIS BEFORE BUILDING THE IMAGE
#
# Next.js inlines every NEXT_PUBLIC_* value into the JavaScript bundle at BUILD
# time. Putting them in this file is not enough: they have to be passed as
# --build-arg when the frontend image is built, because by the time a container
# starts, the bundle is already written.
#
# Get this wrong and the failure is quiet and total — NEXT_PUBLIC_KEYCLOAK_URL
# defaults to an empty string, isKeycloakConfigured() returns false, and the
# login page renders with its button permanently disabled. Nothing errors; the
# deployment simply cannot be signed into.
#
#   docker build --target prod \
#     --build-arg NEXT_PUBLIC_KEYCLOAK_URL=https://$PUBLIC_HOST/auth \
#     --build-arg NEXT_PUBLIC_API_BASE_URL=https://$PUBLIC_HOST/api/v1 \
#     ...
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=https://healthdoc.example.org/api/v1
NEXT_PUBLIC_KEYCLOAK_URL=https://healthdoc.example.org/auth
NEXT_PUBLIC_KEYCLOAK_REALM=healthdoc
NEXT_PUBLIC_OIDC_CLIENT_ID=healthdoc-frontend
# Idle logout. Clinical workstations are shared and often unattended.
NEXT_PUBLIC_SESSION_IDLE_MINUTES=15

# Anything not in {dev,test,local} disables /docs, /redoc and /openapi.json.
# An exposed schema is an information-disclosure finding under WASA.
ENVIRONMENT=production
