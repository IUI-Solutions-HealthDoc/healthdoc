# HealthDoc on Railway: service variables.
# Comments sit on their own lines: an inline "# ..." could be pasted into a value.
#
# Paste each section into that service's Variables tab (Raw Editor). Values in
# ${{...}} are Railway reference variables and are resolved by Railway; leave
# them as written. Everything marked COPY must be the exact value from the
# PC's .env, or data already on the PC cannot be read after the move.
# Never commit a filled-in copy of this file.

# ---------------------------------------------------------------- shared ----
# Project Settings -> Shared Variables
# the edge service's custom domain
PUBLIC_HOST=app.healthdoc.world

# --------------------------------------------------------------- backend ----
# Also used, unchanged, by monitor-capture and each abdm-runner-* service.
PORT=8000
ENVIRONMENT=production
API_MODE=hospital
DATABASE_URL=postgresql+asyncpg://${{Postgres.PGUSER}}:${{Postgres.PGPASSWORD}}@${{Postgres.PGHOST}}:${{Postgres.PGPORT}}/${{Postgres.PGDATABASE}}
MONGO_URI=${{MongoDB.MONGO_URL}}/healthdoc?authSource=admin
REDIS_URL=${{Redis.REDIS_URL}}
JWT_ISSUER=https://${{shared.PUBLIC_HOST}}/auth/realms/healthdoc
JWT_JWKS_URL=http://keycloak.railway.internal:8080/auth/realms/healthdoc/protocol/openid-connect/certs
JWT_AUDIENCE=healthdoc-backend
KEYCLOAK_BASE_URL=http://keycloak.railway.internal:8080/auth
KEYCLOAK_ADMIN=${{keycloak.KEYCLOAK_ADMIN}}
KEYCLOAK_ADMIN_PASSWORD=${{keycloak.KEYCLOAK_ADMIN_PASSWORD}}
CORS_ORIGINS=https://${{shared.PUBLIC_HOST}}
MINIO_ENDPOINT=minio.railway.internal:9000
MINIO_PUBLIC_ENDPOINT=${{minio.RAILWAY_PUBLIC_DOMAIN}}
MINIO_ROOT_USER=${{minio.MINIO_ROOT_USER}}
MINIO_ROOT_PASSWORD=${{minio.MINIO_ROOT_PASSWORD}}
MINIO_REGION=us-east-1
MINIO_BUCKET_FILES=hd-files
MINIO_BUCKET_REPORTS=hd-reports
DATA_ACCESS_LOG_FALLBACK_PATH=/var/log/healthdoc/data_access_log_fallback.jsonl
# COPY from the PC's .env (encryption and hashing of stored identifiers):
PII_ENCRYPTION_KEY=
AADHAAR_HMAC_KEY=
AADHAAR_ENCRYPTION_KEY=
AADHAAR_HMAC_KEYS_JSON=
AADHAAR_ENCRYPTION_KEYS_JSON=
# COPY from the PC's .env (ABDM sandbox identity; keep sandbox values):
ABDM_GATEWAY_BASE_URL=https://dev.abdm.gov.in
ABDM_ABHA_BASE_URL=https://abhasbx.abdm.gov.in/abha/api
ABDM_X_CM_ID=sbx
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_HFR_FACILITY_ID=
ABDM_ADDITIONAL_HFR_FACILITY_IDS=
ABDM_HIP_ID=
ABDM_HIU_ID=
ABDM_PUBLIC_KEY_PEM=
ABDM_CALLBACK_SHARED_SECRET=
ABDM_CALLBACK_EVIDENCE_ENABLED=true
ABDM_HIU_CALLBACK_BASE_URL=https://abdm.healthdoc.world
ABDM_SANDBOX_LOCAL_AUTHOR_CONTEXT_IDS=[]
ABDM_SANDBOX_TEST_REQUESTER_USER_IDS=[]
# COPY (relay or msg91)
ABDM_LINK_OTP_SENDER=
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_API=flow
# Any other non-empty ABDM_* / MSG91_* line in the PC's .env: copy it too.

# --------------------------------------------------- abdm-runner-dev001 ----
# Backend variables above PLUS these three. Do not deploy until README step 6.
ABDM_RUNNER_FACILITY_ID=00000000-0000-0000-0000-000000000101
ABDM_RUNNER_SERVICE_ID=IN0910034387
ABDM_RUNNER_CREATED_SINCE=2026-10-03T19:06:56.025009Z

# --------------------------------------------------- abdm-runner-dev002 ----
ABDM_RUNNER_FACILITY_ID=27f14651-2424-4936-8fce-ca2a6c844b4a
ABDM_RUNNER_SERVICE_ID=IN2710005985
ABDM_RUNNER_CREATED_SINCE=2026-10-06T13:22:53Z

# -------------------------------------------------------------- frontend ----
# Read at BUILD time (Next inlines NEXT_PUBLIC_*); Railway passes service
# variables to the Dockerfile's ARGs. Relative on purpose: one build then works
# on the Railway domain, the custom domain and inside the desktop app.
PORT=3000
NEXT_PUBLIC_API_BASE_URL=/api/v1
NEXT_PUBLIC_KEYCLOAK_URL=/auth
NEXT_PUBLIC_KEYCLOAK_REALM=healthdoc
NEXT_PUBLIC_OIDC_CLIENT_ID=healthdoc-frontend
NEXT_PUBLIC_SESSION_IDLE_MINUTES=15

# -------------------------------------------------------------- keycloak ----
PORT=8080
# build variable for the realm render
PUBLIC_HOST=${{shared.PUBLIC_HOST}}
KC_HOSTNAME=https://${{shared.PUBLIC_HOST}}/auth
KC_DB_URL=jdbc:postgresql://${{KeycloakDB.PGHOST}}:${{KeycloakDB.PGPORT}}/${{KeycloakDB.PGDATABASE}}
KC_DB_USERNAME=${{KeycloakDB.PGUSER}}
KC_DB_PASSWORD=${{KeycloakDB.PGPASSWORD}}
KEYCLOAK_ADMIN=admin
# generate a long random value
KEYCLOAK_ADMIN_PASSWORD=

# ----------------------------------------------------------------- minio ----
PORT=9000
MINIO_ROOT_USER=healthdoc
# generate; or COPY from the PC to reuse mc aliases
MINIO_ROOT_PASSWORD=

# ------------------------------------------------------------------ edge ----
# nginx. Only this service (and minio, for downloads) gets a public domain.
PORT=8080
BACKEND_HOST=backend.railway.internal
FRONTEND_HOST=frontend.railway.internal
KEYCLOAK_HOST=keycloak.railway.internal
