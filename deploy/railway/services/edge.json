{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {"builder": "DOCKERFILE", "dockerfilePath": "deploy/railway/nginx/Dockerfile", "watchPatterns": ["/infra/nginx/**", "/deploy/railway/nginx/**"]},
  "deploy": {"healthcheckPath": "/api/v1/health", "healthcheckTimeout": 120, "restartPolicyType": "ON_FAILURE", "restartPolicyMaxRetries": 5}
}
